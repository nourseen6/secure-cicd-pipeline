# Copy this file to jenkins/.env and set your own values.
# .env is ignored by Git — never commit real passwords.
JENKINS_ADMIN_PASSWORD=change-me

# Group ID of /var/run/docker.sock. Find it with:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c %g /var/run/docker.sock
DOCKER_GID=1001
